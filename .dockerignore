# Allow only the API build inputs into the context, then deny private material.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
!apps/web/package.json
!packages/
!packages/shared/
!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/src/
!packages/shared/src/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*service-account*.json
**/application_default_credentials.json
**/credentials*.json
**/*.p12
**/*.pfx
**/.git/**
**/node_modules/**
**/*.log
**/logs/**
**/.aws/**
**/.gcloud/**
**/.codex/**
**/private/**
**/private-stores/**
**/*.sqlite*
**/*.db
**/test-artifacts/**
**/work/**
