# Documentation only: never source this file automatically or put credentials here.
# ADC is managed by gcloud outside the repository; no downloaded key is needed.
GOOGLE_CLOUD_PROJECT=slamsort
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8080
# Local API mode (mutually exclusive with public mode).
SLAMSORT_LOCAL_AI=false
SLAMSORT_PUBLIC_AI=false
SLAMSORT_API_ORIGIN=http://127.0.0.1:8080
# Public API mode: configure at deployment, not in client source.
FIREBASE_AUTH_PROJECT_ID=<Firebase authentication project ID>
FIREBASE_WEB_CONFIG=<public Firebase web configuration JSON>
ALLOWED_ORIGINS=<exact comma-separated HTTPS website origins>
# Frontend build: public HTTPS API origin only, never a credential.
VITE_API_BASE_URL=<HTTPS API origin, or omit for local development>
