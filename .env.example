# Reference only. The user creates .env manually; no setup command loads it.
# API process: explicitly supply these through your shell/runtime later.
GOOGLE_CLOUD_PROJECT=slamsort
GOOGLE_CLOUD_LOCATION=<location supporting the chosen model>
GEMINI_MODEL=<supported model ID>
PORT=8080
# Optional web dev-server proxy target when API PORT changes. Consumed by Vite config.
SLAMSORT_API_ORIGIN=http://127.0.0.1:8080

# Future browser Firebase configuration: public identifiers only, never secrets.
# Not consumed by the shell yet. Only import firebase/app and firebase/auth later.
VITE_FIREBASE_API_KEY=<public Firebase web API key>
VITE_FIREBASE_AUTH_DOMAIN=<Firebase auth domain>
VITE_FIREBASE_PROJECT_ID=slamsort
VITE_FIREBASE_STORAGE_BUCKET=<Firebase web config storage bucket, if provided>
VITE_FIREBASE_MESSAGING_SENDER_ID=<Firebase web config sender ID>
VITE_FIREBASE_APP_ID=<Firebase web app ID>
# Do not add service-account keys, AI keys, or any secret to VITE_*.
